datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String               @id @default(cuid())
  name          String?
  email         String?              @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  workspaceCredentials WorkspaceCredential[]
  onboardingProgress   OnboardingProgress?
  contacts             Contact[]
  emailCategories      EmailCategory[]
  capabilityProgress   UserCapabilityProgress[]
  practiceDays         CapabilityPracticeDay[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model Account {
  id                 String   @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @id
  expires    DateTime

  @@unique([identifier, token])
}

model WorkspaceCredential {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String   @unique
  accessToken   String   @db.Text
  refreshToken  String   @db.Text
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// --- Hands-free email: onboarding & priority data ---

model OnboardingProgress {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  // 0 Setup / 1 Priorities / 2 Listening / 3 Responding / 4 Acting
  stage     Int      @default(0)
  // Consecutive-day usage streak, for the infrequent session-start-only
  // verbal callout. lastActiveDate is a plain calendar date (UTC midnight)
  // so "today vs. yesterday vs. a gap" comparisons don't need timezone math.
  streakDays     Int       @default(0)
  lastActiveDate DateTime?
  updatedAt DateTime @updatedAt
}

model Contact {
  id       String  @id @default(cuid())
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  email    String
  name     String?
  // 0 normal, 1 VIP
  priority Int     @default(0)

  @@unique([userId, email])
}

model EmailCategory {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  name     String
  keywords String[]
  priority Int      @default(0)

  @@unique([userId, name])
}

// --- Gamified skills checklist: generic, reusable across future "Handsfree X" domains ---

model CapabilityGroup {
  id           String       @id @default(cuid())
  key          String       @unique
  label        String
  capabilities Capability[]
  practiceDays CapabilityPracticeDay[]
}

// One row per (user, group, calendar day) on which the user actually used a
// capability in that group. Distinct *days* — not total uses — is what the
// practice tier ladder is built on, because habit formation comes from
// repetition spread over time, and a raw use-count can be run up in a single
// sitting without changing how anyone works. Keeping the days themselves
// (rather than a denormalised counter) means streaks stay recomputable and a
// calendar/heatmap view is possible later without a backfill.
model CapabilityPracticeDay {
  id      String          @id @default(cuid())
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  group   CapabilityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String
  // UTC midnight, matching toUtcDateOnly() so day comparisons need no tz math.
  day     DateTime        @db.Date
  uses    Int             @default(1)

  @@unique([userId, groupId, day])
  @@index([userId, groupId, day])
}

model Capability {
  id       String                   @id @default(cuid())
  group    CapabilityGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  String
  key      String                   @unique
  label    String
  hint     String
  order    Int                      @default(0)
  progress UserCapabilityProgress[]
}

model UserCapabilityProgress {
  id               String     @id @default(cuid())
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  capability       Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  capabilityId     String
  firstCompletedAt DateTime   @default(now())
  // Incremented on every genuine use (including the first) — the checklist
  // itself only cares about firstCompletedAt, but stage-advancement needs to
  // know "how many times since," not just "at least once."
  useCount         Int        @default(1)
  lastUsedAt       DateTime   @default(now())

  @@unique([userId, capabilityId])
}
